NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Shared secret for purging the web cache after admin edits (min 16 chars).
# Must be identical in both apps. Optional — unset means purges are skipped.
REVALIDATE_SECRET=

# Error reporting. Both OPTIONAL — with no DSN the Sentry SDK never initialises
# and behaviour is identical to before.
# SENTRY_DSN is server-only; NEXT_PUBLIC_SENTRY_DSN is inlined into the browser
# bundle (Sentry DSNs are write-only and designed to be public).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
